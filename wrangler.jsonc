{
  "name": "nikoleta-v5",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "kv_namespaces": [ { "binding": "IG_KV", "id": "3ac83e7b22a94d8288452da1731ee8fb" } ],
  "triggers": { "crons": ["0 4 1,15 * *"] },
  "vars": {
    "IG_ACCOUNT": "nikoletamakeup",
    "ENQUIRY_TO": "info@nikoletamakeup.com",
    "ENQUIRY_FROM": "Nikoleta Makeup website <onboarding@resend.dev>"
  }
  // Secrets: npx wrangler secret put IG_TOKEN (Instagram, once Nikoleta authorises the Meta app)
  //          npx wrangler secret put RESEND_API_KEY (form → email; see ENQUIRY.md)
}
